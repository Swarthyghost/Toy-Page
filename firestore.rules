rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and is an admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Admin users collection
    match /admins/{adminId} {
      // Users can read their own admin document; admins can read all
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      
      // Only existing admins can update or delete admin documents
      allow update, delete: if isAdmin();
      
      // Allow creation if the user is one of the predefined master emails
      // This allows the first login to successfully create the record
      allow create: if request.auth != null && 
                       request.auth.uid == adminId &&
                       (
                         request.resource.data.email in [
                           'charlesnnamdiudeagwu@gmail.com',
                           'admin@pleasuretoys.com'
                         ] || isAdmin()
                       );
    }
    
    // Products collection - admin only for write, public read
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Promo codes collection - admin only for write, public read for validation
    match /promoCodes/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Settings collection - admin only for write, public read
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Guides collection - admin only for write, public read
    match /guides/{guideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Orders collection - public create, admin read/write
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Administrative collections - admin only
    match /sales/{saleId} {
      allow read, write: if isAdmin();
    }
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }
    match /inventory_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /stock_adjustments/{adjustmentId} {
      allow read, write: if isAdmin();
    }
    match /purchase_orders/{orderId} {
      allow read, write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }
    match /athenaMessages/{messageId} {
      allow read, write: if isAdmin();
    }
    match /athenaKnowledge/{knowledgeId} {
      allow read, write: if isAdmin();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
